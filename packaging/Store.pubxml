<Project><PropertyGroup>
 <ProcSightPackaging>true</ProcSightPackaging><SelfContained>true</SelfContained><WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
 <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild><AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
 <AppxBundle>Never</AppxBundle><AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
 <UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode><AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
 <DebugType>None</DebugType><DebugSymbols>false</DebugSymbols><PublishTrimmed>false</PublishTrimmed>
</PropertyGroup></Project>

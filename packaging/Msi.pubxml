<Project><PropertyGroup>
 <ProcSightPackaging>true</ProcSightPackaging><ProcSightInstallerFormat>Msi</ProcSightInstallerFormat>
 <WindowsPackageType>None</WindowsPackageType><EnableMsixTooling>false</EnableMsixTooling>
 <SelfContained>true</SelfContained><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
 <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
 <DebugType>None</DebugType><DebugSymbols>false</DebugSymbols><PublishTrimmed>false</PublishTrimmed>
</PropertyGroup></Project>

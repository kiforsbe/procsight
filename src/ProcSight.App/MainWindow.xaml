<Window x:Class="ProcSight.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Window.SystemBackdrop><MicaBackdrop Kind="Base" /></Window.SystemBackdrop>
 <Grid x:Name="WindowRoot">

  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <TitleBar x:Name="AppTitleBar" Title="ProcSight" Height="48">
   <TitleBar.IconSource><BitmapIconSource UriSource="ms-appx:///Assets/ProcSight-32.png" ShowAsMonochrome="False" /></TitleBar.IconSource>
   <TitleBar.Content>
    <AutoSuggestBox x:Name="GlobalSearch" Width="360" PlaceholderText="Type a name, publisher, or PID…" TextChanged="SearchChanged">
     <AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon>
    </AutoSuggestBox>
   </TitleBar.Content>
  </TitleBar>
  <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed"
   PaneDisplayMode="LeftCompact" CompactPaneLength="48" OpenPaneLength="200"
   IsPaneOpen="False" IsTitleBarAutoPaddingEnabled="False" SelectionChanged="Navigate">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="Processes" Tag="Processes" Icon="AllApps" IsSelected="True" />
    <NavigationViewItem Content="Performance" Tag="Performance" Icon="ShowResults" />
    <NavigationViewItem Content="Services" Tag="Services" Icon="Repair" />
    <NavigationViewItem Content="Rules &amp; knowledge" Tag="Knowledge" Icon="Library" />
    <NavigationViewItem Content="AI activity" Tag="AI activity" Icon="Clock" />
   </NavigationView.MenuItems>
   <Border Margin="0,0,12,12" Background="{ThemeResource LayerFillColorDefaultBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
    <Grid x:Name="PageContent" />
   </Border>
  </NavigationView>
 </Grid>
</Window>
